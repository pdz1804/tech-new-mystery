# ============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT FILE
# ============================================================================
# Copy this file to .env and fill in your AWS credentials.
#
# Usage:
#   1. cp .env.example .env
#   2. Fill in AWS credentials below
#   3. Run: docker-compose -f docker-compose.local.yml up
# ============================================================================

# AWS Credentials (required for DynamoDB, S3, Bedrock, Secrets Manager access)
# Get these from AWS Console → IAM → Users → Your User → Security Credentials
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# Optional: API Keys (if not stored in Secrets Manager)
# These will be fetched from AWS Secrets Manager if secrets_manager_arn is set in terraform
# Otherwise, set them here:
# OPENAI_API_KEY=
# TAVILY_API_KEY=
# NEWSAPI_KEY=
# QDRANT_URL=
# QDRANT_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# LANGSMITH_API_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# VOICE_WORKER_SERVICE_TOKEN=
